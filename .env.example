# Public per-environment config for the Vite client.
# Only VITE_-prefixed variables are exposed to the browser — no secrets here.

# Base URL of the news-feed API, including the version prefix.
VITE_API_URL=http://localhost:3000/v1

# Set to "true" only in local development to show the dev-login button, which
# calls POST /users/dev-login (a route the backend mounts only when it runs with
# ENVIRONMENT=development). Leave off/false everywhere else.
VITE_DEV_LOGIN_ENABLED=false
